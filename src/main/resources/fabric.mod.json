{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["JustAHuman"],
  "contact": {
    "homepage": "https://modrinth.com/mod/plugin-claims",
    "sources": "https://github.com/JustAHuman-xD/PluginClaims",
    "issues": "https://github.com/JustAHuman-xD/PluginClaims/issues",
    "discord": "https://discord.gg/y6fV6pbgHB"
  },
  "custom": {
